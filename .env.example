# Database
POSTGRES_PASSWORD=monitoring_password
DATABASE_URL=postgresql://monitoring_user:monitoring_password@localhost:5432/monitoring

# Redis
REDIS_URL=redis://localhost:6379/0

# Vercel
VERCEL_TOKEN=your_vercel_token_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# Heroku
HEROKU_API_KEY=your_heroku_api_key_here
HEROKU_APP_NAMES=["app1", "app2", "app3"]

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Other API Keys (JSON format)
OTHER_API_KEYS={}

# -----------------------------------------------------------------------------
# Backend services to health-check via HTTP GET {url}{health_path}.
# JSON list. health_path is optional (default "/health").
# Fill in the real prod URLs of your services.
# -----------------------------------------------------------------------------
MONITORED_SERVICES=[{"name":"Market Research","url":"https://YOUR-market-research.herokuapp.com","health_path":"/health"},{"name":"Deep Research Agent","url":"https://YOUR-deep-research.herokuapp.com","health_path":"/health"},{"name":"Solutions Backend (open-abroad/planmaster)","url":"https://solutions-backend-f900a16e5ff6.herokuapp.com","health_path":"/health"},{"name":"Social Plan Master","url":"https://social-plan-master-service-7433f88d4db3.herokuapp.com","health_path":"/api/health"},{"name":"User Service","url":"https://YOUR-user-service.herokuapp.com","health_path":"/health"}]

# External API keys.
# Apify: active check + monthly spend/limit (free endpoint).
APIFY_API_TOKEN=
# Serper / Google CSE: presence-only indicator (active check would burn paid quota).
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=

# user-service registration stats (proxied via /api/monitoring/user-stats).
# Token must match STATS_PUBLIC_TOKEN configured on the user-service app.
USER_SERVICE_URL=https://upgrowplan-user-service-3b483837144a.herokuapp.com
USER_SERVICE_STATS_TOKEN=

# --- API authorization ---
# JWT_SECRET: ТОТ ЖЕ секрет, что у user-service (HS512) — для проверки admin-токена.
# Если пусто — авторизация API ВЫКЛЮЧЕНА (dev). В проде обязателен.
JWT_SECRET=
# Токен для server-to-server ingest от market-research-service
# (POST /api/monitoring/reports, /synthesis-logs). Должен совпадать с
# MONITORING_INGEST_TOKEN на market-research-service.
MONITORING_INGEST_TOKEN=

# Email Alerting (SMTP) / IMAP (Zoho) settings
ADMIN_EMAIL=info@upgrowplan.com
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=info@upgrowplan.com
SMTP_PASSWORD=your_smtp_password_here

# IMAP (receive)
IMAP_HOST=imap.zoho.com
IMAP_PORT=993
IMAP_USER=info@upgrowplan.com
IMAP_PASSWORD=your_imap_password_here
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SECONDS=60

# Telegram Alerting (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Frontend
FRONTEND_URL=https://upgrowplan.com
REACT_APP_API_URL=https://api.upgrowplan.com
REACT_APP_WS_URL=wss://api.upgrowplan.com

# Response Time Thresholds (seconds)
RESPONSE_TIME_WARNING_THRESHOLD=2.0
RESPONSE_TIME_CRITICAL_THRESHOLD=5.0

# -----------------------------------------------------------------------------
# In-process scheduler (runs periodic checks + IMAP email fetch inside the web
# dyno, so no separate Celery worker/beat dyno is required).
# Set to false ONLY if you run dedicated worker+beat dynos instead.
# -----------------------------------------------------------------------------
ENABLE_INPROCESS_SCHEDULER=true
HEALTH_CHECK_INTERVAL_SECONDS=300
REDIS_CHECK_INTERVAL_SECONDS=120
CLEANUP_INTERVAL_SECONDS=86400
# IMAP_POLL_INTERVAL_SECONDS controls the email-fetch cadence (see IMAP section).
